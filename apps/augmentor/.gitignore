# Lab artifacts — large and machine-generated
trace/
sessions/
*.log

# Machine-local secrets / endpoints — never commit
.env
.browser-endpoint

# Python bytecode
__pycache__/
*.pyc

# Runtime scratch dir
agent-workdir/

# Per-machine launcher, regenerated by install-native-host.sh
bin/

# Node deps (root + plugin/)
node_modules/

# local site — not part of the extension
website/

# release pack output (scripts/pack-release.sh) — built, not committed
dist/
