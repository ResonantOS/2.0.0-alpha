{
  "manifest_version": 3,
  "name": "Augmentor Agent powered by DSH",
  "version": "0.1.33",
  "description": "Augmentor: a DSH-powered sidecar agent that controls this browser via the native-messaging bridge.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "activeTab", "sidePanel", "windows", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Augmentor — open side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
